<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/clockName"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/themeButton"
                style="@style/CircleButton"
                android:contentDescription="Aparência"
                android:src="@drawable/ic_theme" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Início -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="132dp">

                    <TextView
                        android:id="@+id/greetingText"
                        style="@style/Text.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boa tarde" />

                    <br.com.clockschool.ui.LiveClockView
                        android:id="@+id/schoolClock"
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:autoSizeMaxTextSize="84sp"
                        android:autoSizeMinTextSize="40sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif"
                        android:fontFeatureSettings="tnum"
                        android:gravity="start|center_vertical"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:maxLines="1"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_muted"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="8dp">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_dot" />

                            <TextView
                                android:id="@+id/statusText"
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/calibrationInfo"
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Atalhos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/quickSchedule"
                                style="@style/QuickCircle"
                                android:text="07:00" />

                            <TextView
                                style="@style/QuickLabel"
                                android:text="Sinal" />

                            <TextView
                                style="@style/QuickSub"
                                android:text="horário" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/quickMinus"
                                style="@style/QuickCircle"
                                android:contentDescription="Voltar 1 segundo"
                                android:text="−1s" />

                            <TextView
                                style="@style/QuickLabel"
                                android:text="Ajuste" />

                            <TextView
                                style="@style/QuickSub"
                                android:text="voltar 1 s" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/quickPlus"
                                style="@style/QuickCircle"
                                android:contentDescription="Avançar 1 segundo"
                                android:text="+1s" />

                            <TextView
                                style="@style/QuickLabel"
                                android:text="Ajuste" />

                            <TextView
                                style="@style/QuickSub"
                                android:text="avançar 1 s" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/quickReset"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_circle_surface"
                                android:clickable="true"
                                android:contentDescription="Zerar ajuste"
                                android:focusable="true"
                                android:padding="21dp"
                                android:src="@drawable/ic_reset"
                                android:tint="@color/text_primary" />

                            <TextView
                                style="@style/QuickLabel"
                                android:text="Zerar" />

                            <TextView
                                style="@style/QuickSub"
                                android:text="sem ajuste" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Calibrar -->
                    <LinearLayout
                        style="@style/Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.Title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Calibrar" />

                            <TextView
                                android:id="@+id/scheduleChip"
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_outline"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingStart="16dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="10dp"
                                android:text="07:00" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/calibrateHint"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:id="@+id/calibrateButton"
                            style="@style/Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_dot"
                                android:backgroundTint="#33FFFFFF"
                                android:importantForAccessibility="no"
                                android:padding="11dp"
                                android:src="@drawable/ic_bell"
                                android:tint="@color/on_accent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:text="Tocou agora"
                                android:textColor="@color/on_accent"
                                android:textSize="16sp" />

                            <Space
                                android:layout_width="44dp"
                                android:layout_height="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Código + Widgets -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="168dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/codeCard"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_inverse"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bg_grid" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Text.Title"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Código"
                                        android:textColor="@color/inverse_text"
                                        android:textSize="18sp" />

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_arrow"
                                        android:tint="@color/inverse_secondary" />
                                </LinearLayout>

                                <Space
                                    android:layout_width="1dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/homeCode"
                                    style="@style/Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="—"
                                    android:textColor="@color/inverse_text"
                                    android:textSize="22sp" />

                                <TextView
                                    style="@style/Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="compartilhe o ajuste"
                                    android:textColor="@color/inverse_secondary" />
                            </LinearLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/widgetsCard"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Text.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Relógios"
                                    android:textSize="18sp" />

                                <TextView
                                    android:id="@+id/widgetsBadge"
                                    style="@style/Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_badge"
                                    android:minWidth="24dp"
                                    android:gravity="center"
                                    android:paddingStart="7dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="3dp"
                                    android:text="0"
                                    android:textColor="@color/on_accent"
                                    android:textSize="12sp" />

                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_arrow"
                                    android:tint="@color/text_secondary" />
                            </LinearLayout>

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Cada um com sua calibração"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Widgets -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageWidgets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="132dp">

                    <TextView
                        style="@style/Text.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relógios" />

                    <TextView
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Seus relógios" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Cada relógio tem nome, calibração e aparência próprios. Toque para abrir, segure para excluir." />

                    <LinearLayout
                        android:id="@+id/widgetList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/newWidgetButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_outline"
                            android:importantForAccessibility="no"
                            android:padding="16dp"
                            android:src="@drawable/ic_plus"
                            android:tint="@color/text_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Novo relógio"
                                android:textSize="17sp" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Dê um nome e calibre" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Código -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="132dp">

                    <TextView
                        style="@style/Text.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Código de calibração" />

                    <TextView
                        android:id="@+id/codeBig"
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.04"
                        android:text="—"
                        android:textSize="52sp" />

                    <TextView
                        android:id="@+id/codeHint"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/copyButton"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_circle_surface"
                                android:clickable="true"
                                android:contentDescription="Copiar código"
                                android:focusable="true"
                                android:padding="20dp"
                                android:src="@drawable/ic_copy"
                                android:tint="@color/text_primary" />

                            <TextView
                                style="@style/QuickLabel"
                                android:text="Copiar" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/shareButton"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_circle_surface"
                                android:clickable="true"
                                android:contentDescription="Compartilhar código"
                                android:focusable="true"
                                android:padding="20dp"
                                android:src="@drawable/ic_share"
                                android:tint="@color/text_primary" />

                            <TextView
                                style="@style/QuickLabel"
                                android:text="Enviar" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recebeu um código?" />

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Aplique e fique com o mesmo horário, sem calibrar." />

                        <EditText
                            android:id="@+id/codeInput"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_field"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:hint="XXX-XXX"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                            android:letterSpacing="0.14"
                            android:maxLength="7"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/applyCodeButton"
                            style="@style/Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_marginTop="12dp"
                            android:text="Aplicar código" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Navegação flutuante -->
    <FrameLayout
        android:id="@+id/nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_nav"
        android:elevation="12dp"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_nav_item" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_nav_item" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_nav_item" />
        </LinearLayout>

        <View
            android:id="@+id/navIndicator"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_nav_indicator" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Início"
                android:padding="16dp"
                android:src="@drawable/ic_home"
                android:tint="@color/nav_icon" />

            <ImageView
                android:id="@+id/navWidgets"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Widgets"
                android:padding="16dp"
                android:src="@drawable/ic_widgets"
                android:tint="@color/nav_icon" />

            <ImageView
                android:id="@+id/navCode"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Código"
                android:padding="16dp"
                android:src="@drawable/ic_key"
                android:tint="@color/nav_icon" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
